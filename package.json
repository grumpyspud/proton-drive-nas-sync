{
  "name": "proton-drive-nas-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Third-party Docker app to sync and back up folders between a NAS and Proton Drive. Not affiliated with or endorsed by Proton.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "tsx watch src/cli/m0.ts",
    "m0": "tsx src/cli/m0.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@protontech/crypto": "^2.2.0",
    "@protontech/drive-sdk": "^0.23.0",
    "ky": "^1.14.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "patch-package": "^8.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
