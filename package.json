{
  "name": "proton-drive-nas-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Third-party Docker app to sync and back up folders between a NAS and Proton Drive. Not affiliated with or endorsed by Proton.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "tsx watch src/cli/m0.ts",
    "m0": "tsx src/cli/m0.ts",
    "m1": "tsx src/cli/m1.ts",
    "m2": "tsx src/cli/m2.ts",
    "m3": "tsx src/cli/m3.ts",
    "m4": "tsx src/cli/m4.ts",
    "server": "tsx src/server/index.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@protontech/crypto": "^2.2.0",
    "@protontech/drive-sdk": "^0.23.0",
    "express": "^5.3.0",
    "ky": "^1.14.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "patch-package": "^8.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
